# 跨平台行尾约定
#
# 关键：Shell 脚本必须是 LF。若在 Windows 上被转成 CRLF，
# Linux 执行时报 "/usr/bin/env: 'bash\r': No such file or directory"，
# 且 set -e 会让脚本立刻退出，用户只看到一闪而过的报错。
*.sh            text eol=lf
*.py            text eol=lf
*.md            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.txt           text

# Windows 批处理必须是 CRLF，否则 cmd 解析异常
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# 二进制资源不做行尾转换
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.zip           binary
*.tgz           binary
*.tar           binary
*.gz            binary
*.xlsx          binary
*.docx          binary
*.pptx          binary
*.pdf           binary
*.onnx          binary
*.safetensors   binary
*.jsonl         text eol=lf

# 语言统计：避免把测试与文档算进"源码"占比
tests/*         linguist-documentation=false
*.jsonl         linguist-generated=true
