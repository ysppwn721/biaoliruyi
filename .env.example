# Copy to .env. Keep keys on the server; never commit .env.
ZHILIAN_HOST=127.0.0.1
ZHILIAN_PORT=8765
# Required before binding 0.0.0.0. Username is zhilian.
ZHILIAN_ACCESS_PASSWORD=

# Model is OPTIONAL. Empty values enable offline rules + manual review.
ZHILIAN_LLM_PROVIDER=
ZHILIAN_LLM_BASE_URL=
ZHILIAN_LLM_MODEL=
ZHILIAN_LLM_API_KEY=

# Bailian example: confirm regional endpoint/model ID in your provider console.
# ZHILIAN_LLM_PROVIDER=Alibaba Bailian
# ZHILIAN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ZHILIAN_LLM_MODEL=qwen-plus
# ZHILIAN_LLM_API_KEY=your-key

# Ollama example: pull a model separately and use its EXACT installed name.
# ZHILIAN_LLM_PROVIDER=Ollama
# ZHILIAN_LLM_BASE_URL=http://127.0.0.1:11434/v1
# ZHILIAN_LLM_MODEL=your-installed-model-name
# ZHILIAN_LLM_API_KEY=
