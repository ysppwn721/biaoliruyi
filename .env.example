# Copy to .env. Keep keys on the server; never commit .env.
ZHILIAN_HOST=127.0.0.1
ZHILIAN_PORT=8765
# Required before binding 0.0.0.0. Username is zhilian.
ZHILIAN_ACCESS_PASSWORD=zhilian2026
# 大赛提交要求：软件若设用户名密码，必须在设计文档显著位置注明测试账号。

# DeepSeek official API. Configure the key on the server only.
# Customers use the website without providing their own API keys.
# Empty key keeps rules + manual review available.
DEEPSEEK_API_KEY=
# DeepSeek V4.1 Flash API model ID, verified against official docs on 2026-09-19.
DEEPSEEK_MODEL=deepseek-flash

# 修复完成后本地落盘输出。默认目录为项目根目录下的“导出成果”。
ZHILIAN_OUTPUT_DIR=
# 设为 1 或 true 时，智能体完成后自动落盘；默认关闭。
ZHILIAN_AUTO_EXPORT=0

# Optional local ONNX reranker. Leave empty to use the rules/API fallback.
ZHILIAN_LOCAL_RERANKER_PATH=
ZHILIAN_LOCAL_RERANKER_ENABLED=0
ZHILIAN_LOCAL_RERANKER_DEVICE=auto
ZHILIAN_RERANKER_MAX_LENGTH=512
ZHILIAN_RERANKER_MIN_RAW_SCORE=-2.5
ZHILIAN_RERANKER_MIN_MARGIN=0.10
